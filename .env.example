# Telegram Reel Maker Bot Configuration

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Admin Telegram ID (leave blank to allow all users)
ADMIN_TELEGRAM_ID=

# File size limits in Megabytes
MAX_VIDEO_SIZE_MB=100
MAX_AUDIO_SIZE_MB=30

# Duration in seconds for image-based reels (default: 15s)
OUTPUT_DURATION_SECONDS=15

# Default open-source font path
FONT_PATH=assets/fonts/Roboto-Bold.ttf

# Automatic cleanup of temporary rendering files
CLEANUP_TEMP_FILES=true

# Keep final output reels for X hours
OUTPUT_RETENTION_HOURS=24
